# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# OS
.DS_Store

# Atreides: raw footage and rendered output never belong in version control.
data/input/*
!data/input/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Model weights are downloaded at runtime, not vendored.
*.pth
*.onnx
